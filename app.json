{
  "expo": {
    "name": "dost-app",
    "slug": "dost-app",
    "scheme": "dost",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9F6F0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dost.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "DOST uses your device to convert speech to text. Nothing is recorded or stored.",
        "NSMicrophoneUsageDescription": "DOST uses your device to convert speech to text. Nothing is recorded or stored."
      }
    },
    "androidNavigationBar": {
      "backgroundColor": "#F9F6F0",
      "barStyle": "dark-content"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F9F6F0"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.dost.app",
      "permissions": [
        "RECORD_AUDIO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "DOST uses your device to convert speech to text. Nothing is recorded or stored.",
          "speechRecognitionPermission": "DOST uses your device to convert speech to text. Nothing is recorded or stored."
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-web-browser",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "DostLauncher",
              "label": "DOST",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "description": "Tap to reflect with DOST",
              "previewImage": "./assets/widget-preview.png",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "updatePeriodMillis": 0
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7e95c78c-365d-40ce-b0f2-7cc31d5d8f3e"
      }
    }
  }
}
